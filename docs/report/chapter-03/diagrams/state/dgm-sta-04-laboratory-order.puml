@startuml
title DGM-STA-04 — Trạng thái Laboratory Order
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial

[*] --> ORDERED
ORDERED --> PAYMENT_PENDING : Cần xác nhận thanh toán/BHYT
ORDERED --> QUEUED : Không yêu cầu thanh toán
PAYMENT_PENDING --> QUEUED : Đã đủ điều kiện
QUEUED --> CALLED
CALLED --> IN_PROGRESS
IN_PROGRESS --> RESULT_AVAILABLE : Phát hành kết quả
RESULT_AVAILABLE --> REVIEWED : Bác sĩ đã đọc
CALLED --> MISSED
MISSED --> QUEUED
ORDERED --> CANCELLED
PAYMENT_PENDING --> CANCELLED
REVIEWED --> [*]
CANCELLED --> [*]
@enduml
