// CareFlow lab — physical schema verified against isolated PostgreSQL migrations, 2026-10-20.
// Partial indexes and CHECK/FK constraints are retained as SQL notes below each table.
Project CareFlow_Lab {
  database_type: 'PostgreSQL'
}

Table public.lab_event_outbox {
  event_id uuid [pk]
  aggregate_id uuid [not null]
  event_type varchar(80) [not null]
  exchange_name varchar(100) [not null]
  routing_key varchar(100) [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz
  attempts integer [not null]
  next_attempt_at timestamptz [not null]
  note: '''
UNIQUE (aggregate_id, event_type)
CREATE UNIQUE INDEX lab_event_outbox_pkey ON public.lab_event_outbox USING btree (event_id)
CREATE UNIQUE INDEX lab_event_outbox_aggregate_id_event_type_key ON public.lab_event_outbox USING btree (aggregate_id, event_type)
CREATE INDEX idx_lab_outbox_pending ON public.lab_event_outbox USING btree (next_attempt_at, created_at) WHERE (published_at IS NULL)
'''
}

Table public.lab_order_items {
  id uuid [pk]
  lab_order_id uuid [not null]
  service_code varchar(50) [not null]
  service_name varchar(255) [not null]
  service_point_id varchar(80) [not null]
  required bool [not null]
  status varchar(30) [not null]
  result_value varchar(255)
  result_unit varchar(50)
  reference_range varchar(100)
  result_flag varchar(30)
  comment text
  performed_by_staff_id uuid
  performed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  note: '''
CHECK (((status)::text = ANY ((ARRAY['ORDERED'::character varying, 'COMPLETED'::character varying, 'CANCELLED'::character varying])::text[])))
FOREIGN KEY (lab_order_id) REFERENCES lab_orders(id) ON DELETE CASCADE
CREATE UNIQUE INDEX lab_order_items_pkey ON public.lab_order_items USING btree (id)
CREATE INDEX idx_lab_item_order ON public.lab_order_items USING btree (lab_order_id)
CREATE INDEX idx_lab_item_service_point ON public.lab_order_items USING btree (service_point_id)
'''
}

Table public.lab_orders {
  id uuid [pk]
  consultation_id uuid [not null]
  patient_id uuid [not null]
  ordered_by_doctor_id uuid [not null]
  department_id uuid
  clinical_note text
  status varchar(30) [not null]
  payment_status varchar(30) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  source_queue_entry_id uuid
  source_verified_by uuid
  source_verified_at timestamptz
  version bigint [not null]
  note: '''
CHECK (((status)::text = ANY ((ARRAY['ORDERED'::character varying, 'PAYMENT_PENDING'::character varying, 'QUEUED'::character varying, 'CALLED'::character varying, 'IN_PROGRESS'::character varying, 'RESULT_AVAILABLE'::character varying, 'REVIEWED'::character varying, 'CANCELLED'::character varying])::text[])))
CHECK (((payment_status)::text = ANY ((ARRAY['NOT_REQUIRED'::character varying, 'PENDING'::character varying, 'PAID_ONLINE_MOCK'::character varying, 'PAID_CASH'::character varying, 'COVERED_BY_INSURANCE'::character varying])::text[])))
CREATE UNIQUE INDEX lab_orders_pkey ON public.lab_orders USING btree (id)
CREATE INDEX idx_lab_order_consultation ON public.lab_orders USING btree (consultation_id)
CREATE INDEX idx_lab_order_patient ON public.lab_orders USING btree (patient_id)
CREATE INDEX idx_lab_order_status ON public.lab_orders USING btree (status)
'''
}

Table public.lab_service_catalog {
  service_code varchar(50) [pk]
  service_name varchar(255) [not null]
  service_point_id varchar(100) [not null]
  preparation_instruction varchar(500)
  is_active bool [not null]
  note: '''
CREATE UNIQUE INDEX lab_service_catalog_pkey ON public.lab_service_catalog USING btree (service_code)
'''
}

Ref: public.lab_order_items.lab_order_id > public.lab_orders.id