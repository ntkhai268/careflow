// CareFlow prescription — physical schema verified against isolated PostgreSQL migrations, 2026-10-20.
// Partial indexes and CHECK/FK constraints are retained as SQL notes below each table.
Project CareFlow_Prescription {
  database_type: 'PostgreSQL'
}

Table public.drugs_dictionary {
  id uuid [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(50) [not null]
  name varchar(200) [not null]
  unit varchar(50)
  description text
  active bool [not null]
  note: '''
UNIQUE (code)
CREATE UNIQUE INDEX drugs_dictionary_pkey ON public.drugs_dictionary USING btree (id)
CREATE UNIQUE INDEX drugs_dictionary_code_key ON public.drugs_dictionary USING btree (code)
'''
}

Table public.prescription_event_outbox {
  event_id uuid [pk]
  aggregate_id uuid [not null]
  event_type varchar(80) [not null]
  exchange_name varchar(100) [not null]
  routing_key varchar(100) [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz
  attempts integer [not null]
  next_attempt_at timestamptz [not null]
  note: '''
CREATE UNIQUE INDEX prescription_event_outbox_pkey ON public.prescription_event_outbox USING btree (event_id)
CREATE INDEX idx_prescription_outbox_pending ON public.prescription_event_outbox USING btree (next_attempt_at, created_at) WHERE (published_at IS NULL)
'''
}

Table public.prescription_items {
  id uuid [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  prescription_id uuid [not null]
  medicine_name varchar(255) [not null]
  medicine_code varchar(50)
  unit varchar(50)
  dosage varchar(100)
  frequency varchar(100)
  timing varchar(100)
  duration integer
  quantity integer
  notes text
  note: '''
FOREIGN KEY (prescription_id) REFERENCES prescriptions(id)
CREATE UNIQUE INDEX prescription_items_pkey ON public.prescription_items USING btree (id)
'''
}

Table public.prescriptions {
  id uuid [pk]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  consultation_id uuid [not null]
  patient_id uuid [not null]
  doctor_id uuid [not null]
  diagnosis varchar(500)
  notes text
  follow_up_date date
  status varchar(30) [not null]
  dispensing_service_point_id varchar(80)
  confirmed_at timestamptz
  dispensed_at timestamptz
  dispensed_by_user_id uuid
  replaces_prescription_id uuid
  cancellation_reason varchar(500)
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  follow_up_department varchar(50)
  follow_up_time_slot varchar(30)
  follow_up_status varchar(30) [not null]
  follow_up_appointment_id uuid
  follow_up_error_code varchar(50)
  note: '''
CHECK (((follow_up_status)::text = ANY ((ARRAY['NOT_REQUESTED'::character varying, 'NEEDS_SELECTION'::character varying, 'PENDING'::character varying, 'FAILED'::character varying, 'SCHEDULED'::character varying])::text[])))
CREATE UNIQUE INDEX prescriptions_pkey ON public.prescriptions USING btree (id)
CREATE INDEX idx_prescription_patient ON public.prescriptions USING btree (patient_id)
CREATE INDEX idx_prescription_consultation ON public.prescriptions USING btree (consultation_id)
'''
}

Ref: public.prescription_items.prescription_id > public.prescriptions.id