              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('appointmentDate')) {",
                  "  const d = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "  pm.environment.set('appointmentDate', d.toISOString().slice(0, 10));",
                  "}"
                ]
              }
            },
