            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.environment.set('testUsername', `careflow_${suffix}`);",
                  "pm.environment.set('testEmail', `careflow_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP thành công', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));",
                  "if (pm.response.code !== 204) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.environment.set('userId', json.data && json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Đăng nhập Patient",
          "request": {
            "method": "POST",
