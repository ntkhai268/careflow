          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP thành công', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]));",
                  "if (pm.response.code !== 204) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.accessToken) pm.environment.set('patientToken', json.data && json.data.accessToken);",
                  "  if (json.data && json.data.refreshToken) pm.environment.set('refreshToken', json.data && json.data.refreshToken);",
                  "  if (json.data && json.data.user && json.data.user.id) pm.environment.set('userId', json.data && json.data.user && json.data.user.id);",
                  "}"
                ]
              }
            }
