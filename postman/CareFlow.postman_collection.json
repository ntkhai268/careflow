                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.environment.set('appointmentId', json.data && json.data.id);",
                  "  if (json.data && json.data.roomId) pm.environment.set('roomId', json.data && json.data.roomId);",
                  "  if (json.data && json.data.departmentId) pm.environment.set('departmentId', json.data && json.data.departmentId);",
