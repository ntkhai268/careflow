# Local development defaults.

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Chỉ bật cục bộ để Swagger trả reset token; production phải để false.
PASSWORD_RESET_EXPOSE_TOKEN=false

# ====== PostgreSQL ======
POSTGRES_USER=careflow
POSTGRES_PASSWORD=careflow

# ====== RabbitMQ ======
RABBITMQ_USER=careflow
RABBITMQ_PASSWORD=careflow

# ====== GitHub ======
GITHUB_USERNAME=your-github-username
